{
  "manifest_version": 3,
  "name": "NEON//WAVE — Liquid Glass for Spotify",
  "version": "2.0.0",
  "description": "A lightweight liquid-glass appearance for Spotify Web Player with a blurred current-track artwork background.",
  "permissions": ["storage"],
  "host_permissions": ["https://open.spotify.com/*"],
  "action": {
    "default_title": "NEON//WAVE settings",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["styles/theme.css"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}